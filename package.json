{
  "name": "apermo-score-cards",
  "version": "1.0.0",
  "description": "Gutenberg blocks for card and board game score cards with automatic calculations.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "author": "Christoph Daum <me@christoph-daum.de>",
  "main": "build/index.js",
  "scripts": {
    "prepare": "husky",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js src/",
    "lint:js:fix": "wp-scripts lint-js src/ --fix",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "lint:css:fix": "wp-scripts lint-style 'src/**/*.scss' --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50",
    "@wordpress/scripts": "^28.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^13.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/compose": "^7.0.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "uuid": "^9.0.0"
  }
}
