<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="apermo-score-cards"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

    <description>PHPCS configuration for apermo-score-cards.</description>

    <file>.</file>
    <exclude-pattern>.ddev/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>

    <rule ref="Apermo">
        <!--
            Plugin code mixes camelCase ($postId, $blockId, $finalScores...)
            for JS interop. Snake-case enforcement on locals is noise here.
        -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>

        <!-- Apermo enforces Yoda; the plugin is consistently non-Yoda. -->
        <exclude name="Generic.ControlStructures.DisallowYodaConditions"/>

        <!--
            Legacy plugin code has long functions / high cognitive
            complexity / long closures. To be paid down incrementally;
            today the noise blocks the structural integration PR.
        -->
        <exclude name="SlevomatCodingStandard.Functions.FunctionLength"/>
        <exclude name="SlevomatCodingStandard.Complexity.Cognitive"/>
        <exclude name="Universal.FunctionDeclarations.NoLongClosures"/>
        <exclude name="SlevomatCodingStandard.Variables.UnusedVariable"/>

        <!--
            Apermo flags any reference to the global $post or to functions
            (get_the_ID, get_the_title, ...) that read it. WP best-practice
            but the renderer classes use this pattern everywhere; tracked
            for follow-up.
        -->
        <exclude name="Apermo.WordPress.GlobalPostAccess"/>
        <exclude name="Apermo.WordPress.ImplicitPostFunction"/>

        <!--
            Apermo formatting rules around assignment-operator and double-
            arrow alignment fight phpcbf in complex array literals.
        -->
        <exclude name="Apermo.Formatting.ConsistentAssignmentAlignment"/>
        <exclude name="Apermo.Arrays.ConsistentDoubleArrowAlignment"/>

        <!--
            Apermo enforces third-person summaries; the WP-style "Initialize
            the X" docblocks scattered across the legacy plugin would each
            need a manual rewrite. Tracked for follow-up.
        -->
        <exclude name="Apermo.Commenting.DocSummaryStyle"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="apermo-score-cards"/>
            </property>
        </properties>
    </rule>

    <!--
        Project prefix for global functions, hooks, constants,
        and namespace roots. E.g. prefix "Apermo_Score_Cards" allows
        namespace Apermo_Score_Cards\Admin but flags Other\Admin.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="Apermo\ScoreCards"/>
                <element value="apermo_score_cards"/>
                <element value="ASC_"/>
            </property>
        </properties>
        <!-- Test bootstrap uses standard WP test globals, not plugin globals. -->
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <!--
            Block render templates are top-level scripts called by WP_Block;
            their locals look like file-scope vars to PHPCS even though
            they're scoped to the render context. WPCS over-flags them.
        -->
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>

    <!--
        Block render templates run at file scope under WP_Block::render;
        their locals look like top-level vars to PHPCS and trigger a slew of
        sniffs that don't apply to render templates (short loop vars,
        Yoda, assignment alignment, $post overrides from the_post()).
        Skip the strict sniffs on these files.
    -->
    <rule ref="Generic.ControlStructures.DisallowYodaConditions">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>
    <rule ref="Apermo.NamingConventions.MinimumVariableNameLength">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>
    <rule ref="Apermo.Formatting.ConsistentAssignmentAlignment">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>
    <rule ref="Universal.FunctionDeclarations.NoLongClosures">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable">
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>

    <config name="minimum_wp_version" value="6.4"/>

    <!--
        Warnings (short var names, function length, complexity)
        are tracked but should not fail CI or pre-commit hooks.
    -->
    <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
